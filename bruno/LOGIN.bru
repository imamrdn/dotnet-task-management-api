meta {
  name: LOGIN
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "cek@example.com",
    "password": "secret123"
  }
}

script:post-response {
  const body = res.getBody();

  if (res.getStatus() === 200 && body.token) {
    bru.setEnvVar("authToken", body.token, { persist: true });
  }
}
