meta {
  name: LOGIN USER
  type: http
  seq: 9
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "user@mail.com",
    "password": "secret123"
  }
}

script:post-response {
  const body = res.getBody();

  if (res.getStatus() === 200 && body.data?.token) {
    bru.setEnvVar("authToken", body.data.token);
  }

  if (res.getStatus() === 200 && body.data?.refreshToken) {
    bru.setEnvVar("refreshToken", body.data.refreshToken);
  }
}
