meta {
  name: 01 LOGIN ADMIN
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "email": "admin@mail.com",
    "password": "secret123"
  }
}

script:post-response {
  const body = res.getBody();

  if (res.getStatus() === 200 && body.data?.token) {
    bru.setEnvVar("authToken", body.data.token);
  }
}
